{
  "info": {
    "_postman_id": "6f1c2e52-8f1e-4d5f-9f7e-9f0b8f1e2000",
    "name": "NumPrecim API",
    "description": "Rotas da numprecim-node-api.\n\nAntes de testar, configure as variáveis da collection:\n- `baseUrl` — padrão http://localhost:3000\n- `idToken` — cole um ID Token do Firebase (Authorization: Bearer herdado por todas as rotas)\n- `cronSecret` — valor do CRON_SECRET no .env (para o job de preços)\n- `productId` — preenchido automaticamente ao criar/listar produtos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{idToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "idToken", "value": "COLE_SEU_ID_TOKEN_DO_FIREBASE_AQUI" },
    { "key": "cronSecret", "value": "SEU_CRON_SECRET_AQUI" },
    { "key": "productId", "value": "" },
    { "key": "days", "value": "90" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "POST /api/users (registrar após 1º login)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Luis\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "GET /api/users/me",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          }
        },
        {
          "name": "PATCH /api/users/me",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Novo Nome\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "POST /api/products (criar + scrape)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('productId', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_url\": \"https://exemplo.com.br/produto/1\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "GET /api/products (listar)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const produtos = pm.response.json();",
                  "if (Array.isArray(produtos) && produtos.length && !pm.collectionVariables.get('productId')) {",
                  "  pm.collectionVariables.set('productId', produtos[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "GET /api/products/:id (detalhe)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            }
          }
        },
        {
          "name": "GET /api/products/:id/history",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}/history?days={{days}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}", "history"],
              "query": [
                { "key": "days", "value": "{{days}}" }
              ]
            }
          }
        },
        {
          "name": "DELETE /api/products/:id",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Push",
      "item": [
        {
          "name": "POST /api/push/subscribe",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/push/subscribe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "push", "subscribe"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"endpoint\": \"https://fcm.googleapis.com/fcm/send/exemplo\",\n  \"keys\": {\n    \"p256dh\": \"exemplo-p256dh\",\n    \"auth\": \"exemplo-auth\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "DELETE /api/push/unsubscribe",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/push/unsubscribe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "push", "unsubscribe"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"endpoint\": \"https://fcm.googleapis.com/fcm/send/exemplo\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "POST /api/jobs/check-prices (cron)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "x-cron-secret", "value": "{{cronSecret}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/check-prices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "check-prices"]
            }
          }
        }
      ]
    }
  ]
}
